# =============================================================================
# Caddy — Reverse Proxy für FIDE Scraping Dashboard
# =============================================================================
#
# Setup auf dem VPS (einmalig):
#
#   1. Hostinger hPanel → Domains → DNS-Zone → A-Record hinzufügen:
#        Name:    scraper          (oder gewünschte Subdomain)
#        Wert:    187.124.181.116
#        TTL:     3600
#
#   2. Domain in dieser Datei eintragen (Zeile unten)
#
#   3. Passwort-Hash generieren:
#        caddy hash-password
#        → Hash kopieren und unten bei 'peter' eintragen
#
#   4. Caddy installieren und starten:
#        sudo apt install -y caddy
#        sudo cp /opt/fide-scraper/orchestrator/caddy/Caddyfile /etc/caddy/Caddyfile
#        sudo systemctl enable --now caddy
#
#   Caddy holt automatisch ein Let's-Encrypt-Zertifikat (HTTPS, kostenlos).
#   Port 80 + 443 müssen in der Hostinger-Firewall offen sein.
#   Port 8050 bleibt auf 127.0.0.1 — nicht öffentlich erreichbar.
# =============================================================================

scelo.chesspit.de {

    reverse_proxy localhost:8050

    basicauth {
        # caddy hash-password → Hash hier eintragen
        peter $2a$14$AxmEncpsINswxyIJneTobunbJmseSDGwHJsi27DProe4P9e7TPfOy
    }
}
