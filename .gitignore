.env
.env.*
.venv/
.ipynb_checkpoints/
__pycache__/
*.pyc
*.pyo
.DS_Store
*.log
.pytest_cache/

# Large data files (FIDE player lists ~200MB uncompressed / ~30-50MB zipped)
data/*.txt
data/*.zip
data/*.pdf
players_list_foa*.txt
players_list_foa*.zip

# Notebook-generated CSV exports
notebooks/*.csv

# Orchestrator-Laufzeitdaten (werden auf dem VPS neu generiert)
# scraper.db: Queue-Stand (done/pending/failed) — ändert sich mit jedem Scraping-Lauf
# worker_state.json: aktueller Worker-Status (run/pause/stopped)
orchestrator/scraper.db
orchestrator/scraper.db-shm
orchestrator/scraper.db-wal
orchestrator/worker_state.json
orchestrator/__pycache__/

# DB-Dumps (lokal, zu groß für Git)
backups/

# Frontend-Caches (zur Laufzeit generiert)
frontend/*.parquet

# Screenshots + Playwright-Temp
*.png
.playwright-mcp/

# Frontend-Daten-Export
frontend_data/
