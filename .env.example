DB_PASSWORD=changeme
DATABASE_URL=postgresql://fide:changeme@db:5432/fidedb
# DB-Rollen (Phase 2a, docs/db_rollen.md) — optional. core.config.get_database_url(role)
# nimmt DATABASE_URL_<ROLLE>, sonst DATABASE_URL. Erst setzen, wenn die Rollen angelegt sind.
#DATABASE_URL_INGEST=postgresql://fide_ingest:...@localhost:5434/fidedb
#DATABASE_URL_QC=postgresql://fide_qc:...@localhost:5434/fidedb
#DATABASE_URL_READER=postgresql://fide_reader:...@localhost:5434/fidedb
LOG_LEVEL=INFO

# Proxy-Provider: DataImpulse Residential Rotating (Pay-as-you-go, GB-Abrechnung).
# Gateway gw.dataimpulse.com:823 steht in orchestrator/dataimpulse_gateway.txt —
# neue Residential-IP pro Request. Login + Passwort aus dem DataImpulse-Dashboard.
# Country-Targeting hängt am Login-Namen: LOGIN__cr.de → nur deutsche IPs.
# Basis-Login (weltweite Rotation) — genutzt von den Residential-Slots (worker_slots):
PROXY_USERNAME=your_dataimpulse_login
PROXY_PASSWORD=your_dataimpulse_password
PROXY_POOL_FILE=orchestrator/dataimpulse_gateway.txt
# Länder-Logins pro DC-Thread (profiles.yaml::username_env) — gleicher Login,
# nur mit __cr.<land>-Suffix; Passwort für alle identisch:
PROXY_DI_PASSWORD=your_dataimpulse_password
PROXY_DI_USERNAME_DE=your_dataimpulse_login__cr.de
PROXY_DI_USERNAME_IN=your_dataimpulse_login__cr.in
PROXY_DI_USERNAME_GB=your_dataimpulse_login__cr.gb
PROXY_DI_USERNAME_US=your_dataimpulse_login__cr.us
PROXY_DI_USERNAME_HK=your_dataimpulse_login__cr.hk
PROXY_DI_USERNAME_ES=your_dataimpulse_login__cr.es
PROXY_DI_USERNAME_MX=your_dataimpulse_login__cr.mx
PROXY_DI_USERNAME_AE=your_dataimpulse_login__cr.ae
PROXY_DI_USERNAME_CH=your_dataimpulse_login__cr.ch
# dc_newplayers_1/2 — Neuzugangs-Backfill (nie gescrapte, aktive Spieler), s. Memory
# std-rating-sync-fix-2026-09-01 / Phase 1.4:
PROXY_DI_USERNAME_CL=your_dataimpulse_login__cr.cl
PROXY_DI_USERNAME_VN=your_dataimpulse_login__cr.vn
# Zweiter DataImpulse-Plan: Worker wechselt automatisch, sobald der Gateway
# Plan 1 ablehnt (z. B. Guthaben aufgebraucht). Nur Login, ohne __cr-Suffix.
# Zurück auf Plan 1: /data/proxy_fallback_active löschen + Worker neu erzeugen.
PROXY_DI_FALLBACK_LOGIN=
PROXY_DI_FALLBACK_PASSWORD=

# Nach HTTP 429 / im Pool-Cooldown direkt (ohne Proxy) fetchen?
# true  = Maschinen, deren eigene IP bei FIDE frei ist (Mac Mini) — Default
# false = Maschinen mit FIDE-geblockter IP (VPS; wird dort in
#         deploy/infomaniak/docker-compose.yml gesetzt)
DIRECT_FALLBACK_ON_429=true

# Docker-Netzwerkname des Haupt-Stacks (prüfen mit: docker network ls | grep fide)
# Standard wenn docker compose aus /opt/fide-scraper läuft: fide-scraper_default
DOCKER_NETWORK=fide-scraper_default

# Dashboard: debug=True nur lokal, nie auf VPS
FLASK_DEBUG=false

# Gerät-Identifikation für den Worker (optional)
# Gruppen mit diesem device-Wert + unzugewiesene Gruppen (device=NULL) werden gescrapt.
# Beispiele: mac_mini | raspi | vps
# Leer lassen = Worker nimmt alle Gruppen
WORKER_DEVICE=

# Anthropic API (ARPAD-Chatbot, /arpad) — Key aus console.anthropic.com/settings/keys.
# Wird lokal über core.config aus diesem .env geladen; im Container nur für die
# interne Frontend-Edition gesetzt (ARPAD ist in EDITION=public nicht registriert).
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Nur Infomaniak-VPS (deploy/infomaniak/docker-compose.yml) ──
# Superuser der eigenen TimescaleDB-Instanz (fide ist nur Owner von fidedb)
POSTGRES_PASSWORD=
# Traefik: Hostnamen + BasicAuth (htpasswd-bcrypt, in EINFACHEN Anführungszeichen wegen der $)
DASHBOARD_HOST=scelo.chesspit.net
FRONTEND_HOST=elo.chesspit.net
# Interne Frontend-Edition (alle Seiten, BasicAuth); DNS-Eintrag legt der User an
INTERN_FRONTEND_HOST=intern-elo.chesspit.net
# Leserolle für beide Frontends (Phase 2a); leer = fide / DB_PASSWORD
READER_DB_USER=
READER_DB_PASSWORD=
# Rate-Limit der öffentlichen Edition je Client-IP (Requests/s, Burst)
PUBLIC_RATELIMIT_AVERAGE=20
PUBLIC_RATELIMIT_BURST=60
BASICAUTH_USERS='user:$2a$14$...'
# optional — Let's Encrypt funktioniert auch ohne
ACME_EMAIL=
# stabile claimed_by-Identität des Workers (wie bisher auf Hostinger)
WORKER_DEVICE_ID=vps
