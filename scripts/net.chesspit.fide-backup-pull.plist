<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- fide-scraper: tägliche Offsite-Kopie der VPS-Backups (siehe pull_backup_macmini.sh).
     RunAtLoad zusätzlich zu StartCalendarInterval: der Mac Mini fährt nachts
     komplett runter und bootet erst gegen 08–09 Uhr wieder hoch (kein Sleep,
     echter Shutdown) - ein reines 07:30-StartCalendarInterval feuert dadurch
     nie, weil die Maschine zu der Uhrzeit aus ist. RunAtLoad fängt das ab,
     StartCalendarInterval (09:30, mit Puffer) bleibt als Fallback für Tage
     ohne Reboot.
     Install:  cp scripts/net.chesspit.fide-backup-pull.plist ~/Library/LaunchAgents/
               launchctl load ~/Library/LaunchAgents/net.chesspit.fide-backup-pull.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.chesspit.fide-backup-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/macminipit/PARA/1_Projects_Git/fide-scraper/scripts/pull_backup_macmini.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>/Users/macminipit/backups/fide-scraper/pull.err</string>
</dict>
</plist>
